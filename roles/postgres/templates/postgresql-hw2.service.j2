[Unit]
Description=PostgreSQL database server for HW2
After=network.target

[Service]
Type=notify
User=postgres
Group=postgres
ExecStart={{ __pg_bin_dir }}/postgres -D {{ postgres__data_dir }}
ExecReload={{ __pg_bin_dir }}/pg_ctl reload -D {{ postgres__data_dir }}
KillMode=mixed
KillSignal=SIGINT
TimeoutSec=0
Restart=on-failure

[Install]
WantedBy=multi-user.target

